PORT=3000
# Permanent/system-user token with WhatsApp messages permission
WHATSAPP_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_phone_number_id
# Any long random value; must match the token entered in Meta Developer dashboard
VERIFY_TOKEN=choose_a_webhook_verify_token
# Optional, but recommended to validate x-hub-signature-256
META_APP_SECRET=your_meta_app_secret
# Bearer token required for protected admin API endpoints
ADMIN_API_TOKEN=replace_with_a_long_random_admin_token
META_GRAPH_VERSION=v23.0
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SYSTEM_PROMPT=You are a helpful WhatsApp AI assistant. Reply clearly, naturally and concisely. Always answer in the user's language.
# MongoDB connection (optional, uses in-memory storage if not provided)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=whatsapp_bot
MAX_HISTORY=20
RATE_LIMIT_MAX=10
MAX_MEDIA_BYTES=15728640
