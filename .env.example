PORT=3000

# WhatsApp provider: ycloud or meta
WHATSAPP_PROVIDER=ycloud

# YCloud server-side credentials/configuration
YCLOUD_API_KEY=your_ycloud_api_key
YCLOUD_API_BASE_URL=https://api.ycloud.com/v2
YCLOUD_SENDER_PHONE=+15551234567
YCLOUD_WEBHOOK_SECRET=your_ycloud_webhook_secret
# Optional: previous secret during a controlled secret cutover
YCLOUD_WEBHOOK_SECRET_PREVIOUS=
# Optional: bind the receiver to one trusted YCloud endpoint identity
YCLOUD_WEBHOOK_ENDPOINT_ID=
YCLOUD_SIGNATURE_TOLERANCE_SECONDS=300

# Legacy Meta Cloud API fallback when WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_phone_number_id
VERIFY_TOKEN=choose_a_webhook_verify_token
META_APP_SECRET=your_meta_app_secret
META_GRAPH_VERSION=v23.0

# Admin API
ADMIN_API_TOKEN=replace_with_a_long_random_admin_token

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SYSTEM_PROMPT=You are a helpful WhatsApp assistant. Reply clearly, naturally and concisely. Always answer in the user's language.

# MongoDB connection (optional, uses in-memory storage if not provided)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=whatsapp_bot
MAX_HISTORY=20
RATE_LIMIT_MAX=10
MAX_MEDIA_BYTES=15728640
